	(text "Q22 disconnects the - battery lead, but it also kills\nthe ground reference for the ~{SHUTDOOWN} circuit, which \nis bad because it turns on the ABLIC and MAX17 chips. \nSo, R94 preserves the ground reference while not allow\nanny appreciable current to flow."
		(exclude_from_sim no)
		(at 390.906 360.68 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "70de39a5-6da4-441a-aad9-f04a8a5dc9e3")
	)
