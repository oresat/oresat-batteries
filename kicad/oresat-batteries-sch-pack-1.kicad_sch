	(text "Q29 disconnects the - battery lead, but it also kills\nthe ground reference for the ~{SHUTDOOWN} circuit, which \nis bad because it turns on the ABLIC and MAX17 chips. \nSo, R93 preserves the ground reference while not allow\nanny appreciable current to flow."
		(exclude_from_sim no)
		(at 271.526 220.218 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "109a78d4-a92d-4f2d-9e22-62c04109c45c")
	)
