	)
	(text "Q29 disconnects the - battery lead, but it also kills\nthe ground reference for the ~{SHUTDOOWN} circuit, which \nis bad because it turns on the ABLIC and MAX17 chips. \nSo, R93 preserves the ground reference while not allowing\nany appreciable current to flow."
		(exclude_from_sim no)
		(at 387.096 348.488 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "109a78d4-a92d-4f2d-9e22-62c04109c45c")
	)
	(text "EFUSE\n\nCurrent limit: 8.0 A (set +20% to Rilim = 154 ohm = 9.6 A)\nTransient overcurrent timer: 15 n = 5 ms\nFast current limit = 210% * 9.6 A = 20.16 A\n\nVoltage ramp up time: 24 ms\nTime between retries: 4.6 s"
		(exclude_from_sim no)
		(at 251.46 179.324 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "12618e23-2af3-46f9-a88e-608c622e87cf")
	)
